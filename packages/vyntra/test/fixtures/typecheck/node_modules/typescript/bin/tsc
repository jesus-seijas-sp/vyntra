#!/usr/bin/env node
// A stand-in for tsc: for every line of the checked files (the -p tsconfig's "files", and src/) marked
// "// type-error: <message>", it reports that message as tsc does with --pretty false.
const fs = require('node:fs');
const path = require('node:path');

const config = process.argv[process.argv.indexOf('-p') + 1];
const { files = [] } = JSON.parse(fs.readFileSync(config, 'utf8'));
const dir = path.dirname(config);
const sources = fs.readdirSync(path.join(dir, 'src')).map((name) => path.join(dir, 'src', name));
[...files, ...sources].forEach((file) => {
  fs.readFileSync(file, 'utf8')
    .split('\n')
    .forEach((line, i) => {
      const match = /\/\/ type-error: (.*)$/.exec(line);
      if (match) {
        const column = line.search(/\S/) + 1;
        process.stdout.write(`${path.relative(dir, file)}(${i + 1},${column}): error TS2322: ${match[1]}\n`);
      }
    });
});
process.exitCode = 2;
