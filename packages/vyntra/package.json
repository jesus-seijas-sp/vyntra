{
  "name": "vyntra",
  "version": "0.6.0",
  "description": "A very fast, zero-dependency test runner with a Jest/Vitest compatible API",
  "homepage": "https://github.com/jesus-seijas-sp/vyntra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesus-seijas-sp/vyntra.git",
    "directory": "packages/vyntra"
  },
  "bugs": {
    "url": "https://github.com/jesus-seijas-sp/vyntra/issues"
  },
  "main": "./src/index.js",
  "type": "commonjs",
  "bin": {
    "vyntra": "./bin/vyntra.js"
  },
  "exports": {
    ".": {
      "import": "./src/index.mjs",
      "require": "./src/index.js"
    },
    "./engine": "./src/engine-api.js",
    "./tooling": "./src/tooling.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "bench/compare.js",
    "docs",
    "agents"
  ],
  "scripts": {
    "test": "node bin/vyntra.js",
    "build-docs": "node scripts/build-docs.js"
  },
  "keywords": [
    "test",
    "testing",
    "runner",
    "jest",
    "vitest",
    "expect",
    "fast"
  ],
  "author": "Jesús Seijas <jseijas@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "vyntra": {
    "exclude": [
      "**/node_modules/**",
      "**/.git/**",
      "test/fixtures/**"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
